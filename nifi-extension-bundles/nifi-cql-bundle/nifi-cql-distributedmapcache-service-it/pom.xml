<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>nifi-cql-bundle</artifactId>
        <groupId>org.apache.nifi</groupId>
        <version>2.12.0-SNAPSHOT</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>nifi-cql-distributedmapcache-service-it</artifactId>
    <packaging>jar</packaging>

    <!--
      Integration tests for CQLDistributedMapCache, and nothing else - there is no src/main here.

      One backend per profile, and only that backend's session provider on the classpath: -Pcassandra brings
      nifi-cassandra-session-provider-service, -Pscylladb brings nifi-scylladb-session-provider-service, and
      neither profile sees the other's driver. Cassandra is the default, so a bare
      `mvn verify -Pintegration-tests` here runs against it; activating -Pscylladb deactivates the default,
      per Maven's activeByDefault semantics.

      The test source itself names no backend type. It reads the provider's class name and the container image
      from properties each profile sets, and instantiates the provider reflectively - which is what lets a
      single src/test/java compile against either profile's classpath. The keyspace is created by running
      cqlsh inside the container rather than through a driver, for the same reason.
    -->

    <properties>
        <!-- Overridden per backend profile below; declared here so the failsafe configuration can be shared. -->
        <dmc.image/>
        <dmc.provider/>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.apache.nifi</groupId>
            <artifactId>nifi-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.nifi</groupId>
            <artifactId>nifi-cql-services-api</artifactId>
            <version>2.12.0-SNAPSHOT</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.nifi</groupId>
            <artifactId>nifi-cql-distributedmapcache-service</artifactId>
            <version>2.12.0-SNAPSHOT</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.nifi</groupId>
            <artifactId>nifi-distributed-cache-client-service-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.nifi</groupId>
            <artifactId>nifi-ssl-context-service-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.nifi</groupId>
            <artifactId>nifi-mock</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
          Testcontainers core only. The backend-specific modules are deliberately not used: the test drives a
          plain GenericContainer, so neither profile picks up a driver transitively - testcontainers-cassandra
          carries the DataStax 3.x driver, which is exactly the mixing these profiles exist to avoid.
        -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <!--
                  Configuration only. The executions come from the root pom's integration-tests profile, so
                  the ITs run under `-Pintegration-tests` and not on an ordinary build. Deliberately not a
                  module-local integration-tests profile: activating a profile cancels activeByDefault for
                  profiles in the same POM, which would silently disable the cassandra profile below and
                  leave these properties empty.
                -->
                <configuration>
                    <systemPropertyVariables>
                        <dmc.image>${dmc.image}</dmc.image>
                        <dmc.provider>${dmc.provider}</dmc.provider>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>cassandra</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <dmc.image>cassandra:5</dmc.image>
                <dmc.provider>org.apache.nifi.service.cassandra.CassandraCQLExecutionService</dmc.provider>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>org.apache.nifi</groupId>
                    <artifactId>nifi-cassandra-session-provider-service</artifactId>
                    <version>2.12.0-SNAPSHOT</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
        </profile>

        <profile>
            <id>scylladb</id>
            <properties>
                <dmc.image>scylladb/scylla:2026.2</dmc.image>
                <dmc.provider>org.apache.nifi.service.scylladb.ScyllaDBCQLExecutionService</dmc.provider>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>org.apache.nifi</groupId>
                    <artifactId>nifi-scylladb-session-provider-service</artifactId>
                    <version>2.12.0-SNAPSHOT</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
        </profile>

    </profiles>
</project>
